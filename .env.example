# Chave privada da wallet, em hex (com ou sem prefixo 0x)
PRIVATE_KEY=

# Endereco da wallet (o mesmo dono da PRIVATE_KEY acima)
SENDER_ADDRESS=

# API key da DeepSeek (opcional). Se vazio, o bot corre normalmente sem o
# analista inteligente -- so nao ajusta parametros nem avalia pools novos.
DEEPSEEK_API_KEY=
